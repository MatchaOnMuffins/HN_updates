{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackernews-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "news.matchaonmuffins.dev",
      "custom_domain": true
    }
  ]
}
